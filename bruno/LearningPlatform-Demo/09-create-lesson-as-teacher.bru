meta {
  name: 09 Create Lesson (Teacher)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/lessons
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{teacherToken}}
}

body:json {
  {
    "courseId": "{{courseId}}",
    "title": "Spring Boot Fundamentals",
    "content": "Spring Boot simplifies Java backend development with autoconfiguration, embedded servers, and production-ready features."
  }
}

script:post-response {
  test("status is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  
  const json = res.getBody();
  bru.setEnvVar("lessonId", json.id);
}
